{
  "name": "portfolio-ugc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-alias.mjs --test \"lib/*.test.ts\" \"modules/**/*.test.ts\" \"components/**/*.test.ts\"",
    "db:types": "npx --yes supabase@latest gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > /tmp/carolos-types.ts && head -1 /tmp/carolos-types.ts | grep -q \"export type Json\" && mv /tmp/carolos-types.ts lib/supabase/database.types.ts && echo \"tipos actualizados\" || (echo \"falhou; database.types.ts nao foi tocado\"; cat /tmp/carolos-types.ts | head -2; exit 1)",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest-knowledge.mjs",
    "eval:ai": "node --import ./scripts/test-alias.mjs scripts/eval-ai.ts",
    "ai:keys": "node --env-file-if-exists=.env.local scripts/ai-keys.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.19.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "gsap": "3.12.5",
    "lottie-web": "^5.13.0",
    "next": "^16.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.18.0",
    "eslint-config-next": "^16.3.0",
    "pdf-parse": "^2.4.5",
    "typescript": "5.7.3"
  }
}
