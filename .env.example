# ── Já existentes: o portfólio público não arranca sem estas ────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── CarolOS: servidor ───────────────────────────────────────────────────────
# Ignora o RLS. Só é usada do lado do servidor, em trabalhos de fundo e para as
# tabelas que a sessão da editora não alcança (os tokens de integração).
# Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base da aplicação, usada para construir o redirect do OAuth.
APP_BASE_URL=http://localhost:3000

# 32 bytes em base64. Cifra os refresh tokens e assina o `state` do OAuth.
# Gerar com:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Autoriza /api/jobs/*. Sem ela, a via automática fica fechada — o endpoint
# recusa em vez de ficar aberto por omissão.
# Gerar com:  openssl rand -hex 32
CRON_SECRET=

# ── Google OAuth (Gmail) ────────────────────────────────────────────────────
# Criados na Google Cloud Console. Ver README para os passos exactos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por omissão é ${APP_BASE_URL}/api/integrations/google/oauth/callback
GOOGLE_REDIRECT_URI=

# ── Camada de IA ────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-sonnet-5
ANTHROPIC_API_KEY=

# ── Travões de ambiente ─────────────────────────────────────────────────────
# Só fecham bandeiras, nunca as abrem. É assim que um preview não fala com o
# Gmail de produção mesmo que a bandeira esteja ligada na base.
CAROLOS_JOBS_ENABLED=true
CAROLOS_EXTERNAL_SEND_ENABLED=false
CAROLOS_AI_ENABLED=true
CAROLOS_GMAIL_ENABLED=true

# ── Testes de integração ────────────────────────────────────────────────────
# Projeto DESCARTÁVEL. Estes testes escrevem e apagam; nunca apontar para
# produção. Sem estas, os testes de integração saltam-se sozinhos.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
SUPABASE_TEST_ANON_KEY=

# ── Carol AI ────────────────────────────────────────────────────────────────
# Quem responde. 'gemini' por omissão; 'anthropic' continua a funcionar.
AI_PROVIDER=gemini

# Gemini. Criar em: https://aistudio.google.com/apikey
# AVISO: no tier gratuito, os prompts e as respostas são usados pela Google para
# melhorar os produtos dela. Isto manda emails reais, contactos e valores
# comerciais. Para não treinar em cima disso, é preciso o tier pago.
GEMINI_API_KEY=

# Chaves extra entram na cadeia: quando uma esgota, a corrida segue na seguinte
# em vez de morrer a meio. Cada uma tem de vir de um projeto diferente — a cota
# é por projeto, não por chave.
GEMINI_API_KEY_2=

# A pesquisa Google NÃO existe no plano grátis, e é a descoberta que a usa: uma
# chamada por corrida. Esta chave, e só esta, vem de um projeto com faturação
# ligada; as outras chamadas todas continuam nas de cima. Sem ela, a descoberta
# falha e diz porquê. Confirmar com `npm run ai:keys`.
GEMINI_SEARCH_API_KEY=

# Vazios usam `gemini-flash-lite-latest` — um alias móvel. Quando a Google
# promover uma versão mais cara a «latest», a fatura sobe sem ninguém mexer em
# nada; fixar a versão trava isso.
GEMINI_CHAT_MODEL=
GEMINI_FAST_MODEL=
GEMINI_DEEP_MODEL=

# Anthropic, se AI_PROVIDER=anthropic.
# Criar em: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_DEEP_MODEL=

# Tectos de custo. Cinco rondas chegam para cruzar marca + emails + preço.
ASSISTANT_MAX_OUTPUT_TOKENS=2048
ASSISTANT_MAX_TOOL_ROUNDS=5

# ── Instagram / Meta ────────────────────────────────────────────────────────
#
# É de onde vem o desempenho real. Sem isto o Content Brain funciona — histórias,
# estrutura, gravação — mas não consegue acompanhar o que ela publica.
#
# O Client Secret e o token são SERVER-ONLY. Nenhum destes nomes pode ganhar
# prefixo NEXT_PUBLIC_: isso põe o segredo no pacote que vai para o browser.
#
# Criar em: https://developers.facebook.com → a app → Instagram → API setup with
# Instagram login. O produto é «Instagram API with Instagram Login», não o
# antigo Basic Display.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# A versão da Graph fica aqui e em lado nenhum mais. Testada: v26.0.
INSTAGRAM_GRAPH_API_VERSION=v26.0

# Tem de bater exatamente com o que estiver registado na consola da Meta.
# Vazio, cai em `${APP_BASE_URL}/api/integrations/instagram/oauth/callback`.
INSTAGRAM_REDIRECT_URI=

# O token que a Meta manda no `GET` de verificação do webhook. Inventado por
# nós, comparado em tempo constante. Nunca aparece na interface.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Só para validar a leitura antes de o OAuth estar ligado. Não é a arquitetura
# final e não existe tela para colar token: quando houver ligação persistida,
# ela ganha sempre. Em produção, deixar vazio.
# INSTAGRAM_USER_ACCESS_TOKEN=

# ── Content Brain ───────────────────────────────────────────────────────────
#
# Transcrição do áudio que ela grava. `disabled` é um estado legítimo: a captura
# por texto continua a funcionar. O Gemini já está instalado e lê áudio.
CONTENT_TRANSCRIPTION_PROVIDER=gemini
CONTENT_TRANSCRIPTION_MODEL=

# O áudio bruto é o dado mais sensível que isto guarda. Depois da transcrição
# confirmada não serve para nada, e um trabalho diário apaga-o.
CONTENT_AUDIO_MAX_SECONDS=600
CONTENT_AUDIO_RETENTION_HOURS=24
